{
    "basic_settings": {
        "description": "基础",
        "type": "object",
        "hint": "插件在哪些会话生效。",
        "items": {
            "only_group": {
                "description": "仅群聊生效",
                "hint": "开启后只在群聊生效；关闭后私聊也可以使用（需平台支持戳一戳）。",
                "type": "bool",
                "default": true
            }
        }
    },
    "poke_settings": {
        "description": "LLM 主动戳",
        "type": "object",
        "hint": "LLM 调用 poke_user 时的次数与节奏。",
        "items": {
            "poke_max_times": {
                "description": "单次最多戳几次",
                "hint": "LLM 传入 times 的上限，超出会被截断；仅 aiocqhttp 平台生效。",
                "type": "int",
                "default": 3
            },
            "poke_interval": {
                "description": "多次戳之间的间隔（秒）",
                "hint": "同一次调用中连续戳多次时，每次之间的等待时间。",
                "type": "float",
                "default": 0.5
            }
        }
    },
    "guide_settings": {
        "description": "关键词引导",
        "type": "object",
        "hint": "普通消息命中关键词时，给 LLM 一条临时提示。",
        "items": {
            "trigger_keywords": {
                "description": "引导触发关键词",
                "hint": "消息包含其中任意一个词时注入提示；留空则不按关键词触发。",
                "type": "list",
                "default": [
                    "笨蛋",
                    "人机",
                    "机器人",
                    "bot",
                    "傻"
                ]
            },
            "guide_cd": {
                "description": "引导最小间隔（秒）",
                "hint": "同一会话内两次注入引导提示的最短间隔。",
                "type": "int",
                "default": 30
            },
            "guide_prompt": {
                "description": "引导提示词",
                "hint": "命中关键词时临时发给 LLM 的提示，不写入对话历史。",
                "type": "text",
                "default": "[轻量戳一戳提示] 如果当前对话氛围适合轻微互动，可以考虑调用 poke_user 工具；不要因为看到提示就强行调用。"
            }
        }
    },
    "bot_poked_settings": {
        "description": "被戳回应",
        "type": "object",
        "hint": "bot 被戳后是否主动回应，以及回应的频率。",
        "items": {
            "respond_poked_enabled": {
                "description": "启用被戳回应",
                "hint": "关闭后只记录被戳事件，不主动回复。",
                "type": "bool",
                "default": true
            },
            "respond_poked_prob": {
                "description": "回应概率（0-1）",
                "hint": "被戳时触发回应的概率；0=不回应，1=每次都回应。",
                "type": "float",
                "default": 1.0
            },
            "respond_poked_cd": {
                "description": "回应最小间隔（秒）",
                "hint": "同一会话内两次主动回应之间的最短间隔，防止连续被戳时刷屏。",
                "type": "float",
                "default": 10
            },
            "respond_poked_write_context": {
                "description": "被戳事件写入上下文",
                "hint": "把被戳事件写成一条纯文本消息，后续对话能自然感知；关闭后仅用于本次回应。",
                "type": "bool",
                "default": true
            },
            "respond_poked_prompt": {
                "description": "回应提示词",
                "hint": "用 {poke_event} 引用戳一戳事件；事件已写入上下文时会引用上文，避免重复。",
                "type": "text",
                "default": "{poke_event}。请用符合人设的方式简短回应（1-2 句），可以反戳回去（用 poke_user 工具）或吐槽。"
            }
        }
    },
    "follow_settings": {
        "description": "群内跟戳",
        "type": "object",
        "hint": "群里有人戳别人时，bot 是否跟着戳。",
        "items": {
            "follow_enabled": {
                "description": "启用群内跟戳",
                "hint": "关闭后不再跟戳，LLM 仍可主动调用 poke_user。",
                "type": "bool",
                "default": true
            },
            "follow_prob": {
                "description": "基础跟戳概率（0-1）",
                "hint": "实际概率会按群氛围和最近发言调整；建议 0.05-0.2。",
                "type": "float",
                "default": 0.1
            },
            "follow_cd": {
                "description": "跟戳最小间隔（秒）",
                "hint": "同一群内两次跟戳之间的最短间隔。",
                "type": "float",
                "default": 3
            },
            "follow_trace_inject_enabled": {
                "description": "注入跟戳原因",
                "hint": "跟戳成功后，把概率命中原因临时告诉下一次 LLM 请求。",
                "type": "bool",
                "default": true
            },
            "follow_trace_ttl": {
                "description": "跟戳原因保留（秒）",
                "hint": "原因缓存的有效期；过期未消费会丢弃。",
                "type": "int",
                "default": 60
            }
        }
    },
    "vibe_settings": {
        "description": "跟戳氛围",
        "type": "object",
        "hint": "按群聊活跃度调整跟戳概率；仅在启用群内跟戳时生效。",
        "items": {
            "vibe_window": {
                "description": "滑动窗口（秒）",
                "hint": "统计最近多少秒内的群消息和跟戳次数。",
                "type": "int",
                "default": 60
            },
            "vibe_active_threshold": {
                "description": "活跃阈值（消息数）",
                "hint": "窗口内消息数达到该值时视为活跃，跟戳概率 ×1.5。",
                "type": "int",
                "default": 5
            },
            "vibe_quiet_threshold": {
                "description": "冷清阈值（消息数）",
                "hint": "窗口内消息数低于该值时视为冷清，跟戳概率 ×0.3。",
                "type": "int",
                "default": 1
            },
            "vibe_max_in_window": {
                "description": "窗口内跟戳上限",
                "hint": "窗口内最多跟戳几次，达到后跳过本轮。",
                "type": "int",
                "default": 1
            }
        }
    },
    "poke_log_settings": {
        "description": "记录与统计",
        "type": "object",
        "hint": "戳一戳记录的持久化与统计注入。",
        "items": {
            "poke_log_persist": {
                "description": "持久化到 JSON",
                "hint": "关闭后记录只保存在内存，重启即清空。",
                "type": "bool",
                "default": true
            },
            "poke_log_path": {
                "description": "记录文件路径",
                "hint": "留空使用默认路径 <plugin_data>/astrbot_plugin_litepoke/poke_log.json。",
                "type": "string",
                "default": ""
            },
            "poke_log_save_interval": {
                "description": "写盘间隔（秒）",
                "hint": "开启持久化后，每隔多少秒把内存记录写入磁盘。",
                "type": "int",
                "default": 60
            },
            "poke_log_window": {
                "description": "短期统计窗口（秒）",
                "hint": "统计最近多少秒的戳一戳事件；被 LLM 读取后清空。",
                "type": "int",
                "default": 60
            },
            "poke_log_daily_keep_days": {
                "description": "日统计保留天数",
                "hint": "按天累计的数据保留多少天，超出自动清理。",
                "type": "int",
                "default": 7
            },
            "poke_log_inject_enabled": {
                "description": "注入统计到提示词",
                "hint": "把近期/当天统计临时附加给 LLM；默认关闭，被戳事件已写入上下文时通常不需要。",
                "type": "bool",
                "default": false
            }
        }
    },
    "diagnostics_settings": {
        "description": "诊断",
        "type": "object",
        "hint": "排查插件行为时使用的日志。",
        "items": {
            "debug_diagnostics": {
                "description": "输出诊断日志",
                "hint": "记录跳过/降级原因（CD、概率未命中、私聊禁用、保存失败等）；平时建议关闭。",
                "type": "bool",
                "default": false
            }
        }
    }
}
